# Шаблон переменных окружения HRC STARS.
# Скопируйте в .env и подставьте свои значения: cp .env.example .env
# .env в git не попадает.

# Порт 5442, а не 5432: на машине уже стоит нативный PostgreSQL 18,
# который занимает стандартный порт.
# ── База данных ────────────────────────────────────────────────────────────────
POSTGRES_USER=hrc
POSTGRES_PASSWORD=hrc_dev_password
POSTGRES_DB=hrc_stars
POSTGRES_PORT=5442
DATABASE_URL="postgresql://hrc:hrc_dev_password@127.0.0.1:5442/hrc_stars?schema=public"

# ── Аутентификация ─────────────────────────────────────────────────────────────
# Сгенерировать секрет: npx auth secret   (или openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Ключ шифрования персональных данных (GDPR). 32 байта в base64.
# Генерация: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ВНИМАНИЕ: потеря ключа = потеря доступа к зашифрованным полям. Хранить в менеджере секретов.
PII_ENCRYPTION_KEY=""

# ── Файловое хранилище (S3-совместимое) ────────────────────────────────────────
# Порты вынесены в переменные, чтобы не конфликтовать с другими проектами
# на этой машине (9000/9001 уже заняты).
# Локально — MinIO. В продакшене подставляются данные S3 / Cloudflare R2,
# больше ничего в коде менять не нужно.
S3_ENDPOINT="http://localhost:9100"
S3_REGION="us-east-1"
S3_BUCKET="hrc-stars"
S3_ACCESS_KEY=hrc_minio
S3_SECRET_KEY=hrc_minio_dev_password
S3_FORCE_PATH_STYLE=true
S3_PORT=9100
S3_CONSOLE_PORT=9101

# ── Почта ──────────────────────────────────────────────────────────────────────
# Локально письма перехватывает Mailpit: http://localhost:8025
# В продакшене — SMTP провайдера или Resend.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE=false
MAIL_FROM="HRC STARS <noreply@hrcstars.local>"
MAILPIT_UI_PORT=8025

# ── Приложение ─────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
DEFAULT_LOCALE=pl

# Учётка первого администратора, создаётся сидом (npm run db:seed).
# После первого входа пароль сменить.
SEED_ADMIN_EMAIL="admin@hrcstars.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
