// Тесты, попытки и аттестации (этап 3).
//
// Ключевое отличие от текущей таблицы Excel: тест версионируется.
// В таблице максимальный балл по BEVERAGE и FOOD менялся со временем,
// а проценты остались от прежних версий — сравнивать людей между собой
// по ним нельзя. Здесь попытка ссылается на версию с её максимумом,
// и процент считается автоматически.

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_TEXT
  MATCHING
  ORDERING
}

enum AttemptMode {
  /// Сдавали в системе
  ONLINE
  /// Сдавали на бумаге, балл внёс менеджер
  PAPER
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  /// Время вышло, ответы засчитаны как есть
  EXPIRED
}

model QuestionBank {
  id         String   @id @default(cuid())
  locationId String
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  location  Location   @relation(fields: [locationId], references: [id])
  questions Question[]

  @@index([locationId])
}

/// Банк вопросов переиспользуется между тестами: один и тот же вопрос
/// может стоять и в базовом тесте по напиткам, и в продвинутом
model Question {
  id      String       @id @default(cuid())
  bankId  String
  type    QuestionType
  text    String
  /// Пояснение, которое показывается при разборе ошибок
  explanation String?
  /// Варианты ответа и правильный ответ. Структура зависит от типа вопроса,
  /// поэтому JSONB, а не набор колонок
  options Json
  answer  Json
  points  Int          @default(1)
  imageKey String?
  isActive Boolean     @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  bank          QuestionBank          @relation(fields: [bankId], references: [id], onDelete: Cascade)
  versionLinks  TestVersionQuestion[]
  answers       TestAnswer[]

  @@index([bankId])
}

model Test {
  id          String  @id @default(cuid())
  locationId  String
  title       String
  description String?
  /// Категория из таблицы: Beverage, Food, Brand, Safety…
  category    String?
  isActive    Boolean @default(true)
  createdById String
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location    Location         @relation(fields: [locationId], references: [id])
  createdBy   User             @relation("TestAuthor", fields: [createdById], references: [id])
  versions    TestVersion[]
  assignments TestAssignment[]

  @@index([locationId])
  @@index([deletedAt])
}

/// Версия фиксирует набор вопросов, максимальный балл и порог.
/// Менять опубликованную версию нельзя — создаётся новая.
model TestVersion {
  id            String   @id @default(cuid())
  testId        String
  versionNumber Int
  maxScore      Int
  /// Проходной балл в процентах. null — берётся значение по умолчанию
  /// из настроек локации
  passThreshold Int?
  timeLimitMinutes Int?
  attemptsAllowed  Int?     @default(3)
  shuffleQuestions Boolean  @default(false)
  shuffleAnswers   Boolean  @default(false)
  showAnswersAfter Boolean  @default(true)
  isPublished      Boolean  @default(false)
  publishedAt      DateTime?
  createdAt        DateTime @default(now())

  test      Test                  @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions TestVersionQuestion[]
  attempts  TestAttempt[]

  @@unique([testId, versionNumber])
  @@index([testId])
}

model TestVersionQuestion {
  id            String @id @default(cuid())
  testVersionId String
  questionId    String
  sortOrder     Int    @default(0)
  points        Int    @default(1)

  testVersion TestVersion @relation(fields: [testVersionId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id])

  @@unique([testVersionId, questionId])
  @@index([testVersionId])
}

/// Назначение теста задаёт его автор: позиция, роль или конкретный человек.
/// Матрица «какой тест обязателен для какой позиции» складывается отсюда,
/// а не задаётся в коде.
model TestAssignment {
  id         String    @id @default(cuid())
  testId     String
  userId     String?
  roleId     String?
  positionId String?
  dueAt      DateTime?
  mandatory  Boolean   @default(true)
  /// Периодичность пересдачи в днях. null — сдаётся один раз
  repeatEveryDays Int?
  createdById String
  createdAt   DateTime @default(now())

  test      Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  user      User?     @relation("TestAssignee", fields: [userId], references: [id], onDelete: Cascade)
  role      Role?     @relation(fields: [roleId], references: [id])
  position  Position? @relation(fields: [positionId], references: [id])
  createdBy User      @relation("TestAssigner", fields: [createdById], references: [id])

  @@index([testId])
  @@index([positionId])
  @@index([userId])
}

model TestAttempt {
  id            String        @id @default(cuid())
  testVersionId String
  userId        String
  mode          AttemptMode   @default(ONLINE)
  status        AttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now())
  submittedAt   DateTime?
  /// Набранный балл и процент от максимума ЭТОЙ версии
  score         Float?
  percent       Float?
  passed        Boolean?
  /// Порог, по которому оценивали именно эту попытку. Сохраняется отдельно:
  /// при изменении порога прошлые результаты не должны переоцениваться
  appliedThreshold Int?
  /// Кто внёс результат бумажной сдачи
  gradedById    String?
  note          String?

  testVersion TestVersion  @relation(fields: [testVersionId], references: [id])
  user        User         @relation("AttemptOwner", fields: [userId], references: [id], onDelete: Cascade)
  gradedBy    User?        @relation("AttemptGrader", fields: [gradedById], references: [id])
  answers     TestAnswer[]

  @@index([userId])
  @@index([testVersionId])
  @@index([submittedAt])
}

model TestAnswer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  /// Ответ пользователя. Структура зависит от типа вопроса
  value      Json
  isCorrect  Boolean?
  points     Float    @default(0)
  answeredAt DateTime @default(now())

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

/// Годовые оценки: REX и Server Evaluation из таблицы — это одно и то же
/// по сути, отличается только тип. Ключевое поле — дата следующей.
model Evaluation {
  id        String    @id @default(cuid())
  userId    String
  type      String
  date      DateTime
  nextDueAt DateTime?
  result    String?
  note      String?
  createdById String
  createdAt DateTime  @default(now())

  user      User @relation("EvaluationSubject", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("EvaluationAuthor", fields: [createdById], references: [id])

  @@index([userId])
  @@index([nextDueAt])
}
